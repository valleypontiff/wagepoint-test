<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
	<Playwright>
		<BrowserName>chromium</BrowserName>
		<ExpectTimeout>5000</ExpectTimeout>
		<LaunchOptions>
			<Headless>false</Headless>
			<Channel>msedge</Channel>
		</LaunchOptions>
	</Playwright>
	<TestRunParameters>
		<Parameter name="baseUrl" value="https://www.wagepoint.com/" />
		<Parameter name="saveTraces" value="onFailure" />
	</TestRunParameters>
</RunSettings>
